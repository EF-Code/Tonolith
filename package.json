{
  "name": "tonolith",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic, verifiable 4-bit processor on TON",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --import tsx --test tests/*.test.ts",
    "assemble:fibonacci": "tsx tools/assembler/cli.ts programs/fibonacci.tasm programs/fibonacci.json",
    "test:contract": "acton test --fuzz-seed 42",
    "test:contract:coverage": "acton test --coverage --coverage-format text --coverage-minimum-percent 89 --fuzz-seed 42",
    "test:contract:mutation": "acton test --mutate --mutate-contract TonolithCpu --mutation-levels critical,major --fuzz-seed 42",
    "gas:snapshot": "acton test --snapshot benchmarks/gas-v1.json --fuzz-seed 42"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "c8": "12.0.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
